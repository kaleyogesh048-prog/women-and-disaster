# Copy this file to .env and fill in your own values

PORT=5000

# Long random text. Used to sign login tokens and hash OTPs.
JWT_SECRET=put-a-long-random-text-here

# Frontend address(es) allowed to call this API. Use * while testing.
# Example: https://my-safeshield.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---------- Firebase Firestore ----------
# Option 1: path to the service account json file you downloaded from Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option 2: paste the whole json in one line (good for Render / Railway)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Only for quick local testing without Firebase. Data is lost when the server stops.
# USE_MEMORY_DB=true

# ---------- SMS ----------
# fast2sms | twilio | console   (console only prints the SMS in this terminal)
SMS_PROVIDER=console
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Send the SOS text to helpline numbers too (181, 100, 1098, 112, 108).
# Most SMS gateways cannot deliver to these short numbers, so the app also shows call buttons.
SMS_TO_HELPLINES=true

# Testing only: sends the OTP back in the API reply so you can see it on screen.
# NEVER keep this true in production.
DEV_SHOW_OTP=true

# ---------- AI assistant (optional) ----------
# Without a key the assistant gives a short built-in safety answer.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
